<Window x:Class="PrisonApp.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Статистичні зведення"
        Width="1100"
        Height="760"
        MinWidth="980"
        MinHeight="700"
        Background="#F4F6F8"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <Border DockPanel.Dock="Bottom"
                Margin="0,18,0,0"
                Padding="16"
                CornerRadius="12"
                Background="#FFFFFF"
                BorderBrush="#D9E2EC"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="140"
                        Padding="12,8"
                        IsDefault="True"
                        IsCancel="True"
                        Content="Закрити" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="20"
                        Background="#FFFFFF"
                        CornerRadius="12"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Статистичні зведення" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#475569"
                                       Text="Огляд складу контингенту, розподілу за статтями, камерами та ієрархією." />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="18"
                                CornerRadius="12"
                                Background="#EEF2FF"
                                BorderBrush="#C7D2FE"
                                BorderThickness="1"
                                HorizontalAlignment="Right">
                            <StackPanel>
                                <TextBlock Foreground="#4338CA"
                                           Text="Загальна кількість ув'язнених" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#1E1B4B"
                                           Text="{Binding TotalPrisoners}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,10,0"
                            Padding="18"
                            Background="#FFFFFF"
                            CornerRadius="12"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Розподіл за статтями КК" />
                            <DataGrid ItemsSource="{Binding ArticleStatistics}"
                                      Margin="0,14,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Стаття"
                                                        Binding="{Binding Article}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Кількість осіб"
                                                        Binding="{Binding Count}"
                                                        Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="18"
                            Background="#FFFFFF"
                            CornerRadius="12"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Розподіл по камерах" />
                            <DataGrid ItemsSource="{Binding CellStatistics}"
                                      Margin="0,14,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Камера"
                                                        Binding="{Binding CellNumber}"
                                                        Width="140" />
                                    <DataGridTextColumn Header="Кількість осіб"
                                                        Binding="{Binding Count}"
                                                        Width="160" />
                                    <DataGridTextColumn Header="Заповненість"
                                                        Binding="{Binding OccupancyDisplay}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,10,0"
                            Padding="18"
                            Background="#FFFFFF"
                            CornerRadius="12"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Звільнення протягом поточного місяця" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#64748B"
                                       Text="{Binding CurrentMonthLabel}" />
                            <DataGrid ItemsSource="{Binding ReleasesThisMonth}"
                                      Margin="0,14,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ПІБ"
                                                        Binding="{Binding FullName}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Дата звільнення"
                                                        Binding="{Binding ReleaseDate, StringFormat=dd.MM.yyyy}"
                                                        Width="180" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="18"
                            Background="#FFFFFF"
                            CornerRadius="12"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Розподіл за місцем в ієрархії" />
                            <DataGrid ItemsSource="{Binding HierarchyStatistics}"
                                      Margin="0,14,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Статус"
                                                        Binding="{Binding Hierarchy}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Кількість"
                                                        Binding="{Binding Count}"
                                                        Width="150" />
                                    <DataGridTextColumn Header="Відсоток"
                                                        Binding="{Binding PercentageDisplay}"
                                                        Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
