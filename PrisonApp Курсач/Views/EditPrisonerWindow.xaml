<Window x:Class="PrisonApp.Views.EditPrisonerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="900"
        Height="820"
        MinWidth="860"
        MinHeight="760"
        Background="#F4F6F8"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="#1F2937" />
            <Setter Property="Margin"
                    Value="0,0,0,6" />
        </Style>

        <Style x:Key="ValidationTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Padding"
                    Value="10,7" />
            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#C7372F"
                                BorderThickness="1"
                                CornerRadius="4">
                            <AdornedElementPlaceholder />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ValidationComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Padding"
                    Value="8,6" />
            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#C7372F"
                                BorderThickness="1"
                                CornerRadius="4">
                            <AdornedElementPlaceholder />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ValidationDatePickerStyle"
               TargetType="DatePicker">
            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#C7372F"
                                BorderThickness="1"
                                CornerRadius="4">
                            <AdornedElementPlaceholder />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <Border DockPanel.Dock="Bottom"
                Margin="0,18,0,0"
                Padding="16"
                CornerRadius="12"
                Background="#FFFFFF"
                BorderBrush="#D9E2EC"
                BorderThickness="1">
            <DockPanel>
                <TextBlock VerticalAlignment="Center"
                           Foreground="#475569"
                           Text="Enter - зберегти, Esc - скасувати" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button Width="130"
                            Margin="0,0,10,0"
                            Padding="12,8"
                            IsDefault="True"
                            Command="{Binding SaveCommand}"
                            Content="Зберегти" />
                    <Button Width="130"
                            Padding="12,8"
                            IsCancel="True"
                            Command="{Binding CancelCommand}"
                            Content="Скасувати" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="20"
                        Background="#FFFFFF"
                        CornerRadius="12"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Text="{Binding WindowTitle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#475569"
                                   Text="Заповніть обов'язкові поля, за потреби вкажіть додаткові відомості та перевірте обчислену дату звільнення." />
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,10,0"
                            Padding="18"
                            Background="#FFFFFF"
                            CornerRadius="12"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Основні дані" />

                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Прізвище *" />
                                <TextBox x:Name="LastNameTextBox"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         MaxLength="100"
                                         Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#C7372F"
                                           Text="{Binding ElementName=LastNameTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Ім'я *" />
                                <TextBox x:Name="FirstNameTextBox"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         MaxLength="100"
                                         Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#C7372F"
                                           Text="{Binding ElementName=FirstNameTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="По батькові" />
                                <TextBox x:Name="MiddleNameTextBox"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         MaxLength="100"
                                         Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#C7372F"
                                           Text="{Binding ElementName=MiddleNameTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Дата народження *" />
                                <DatePicker x:Name="BirthDatePicker"
                                            Style="{StaticResource ValidationDatePickerStyle}"
                                            SelectedDate="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#C7372F"
                                           Text="{Binding ElementName=BirthDatePicker, Path=(Validation.Errors)[0].ErrorContent}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Стаття КК *" />
                                <TextBox x:Name="CriminalArticleTextBox"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         MaxLength="50"
                                         Text="{Binding CriminalArticle, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#C7372F"
                                           Text="{Binding ElementName=CriminalArticleTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Номер камери *" />
                                <TextBox x:Name="CellNumberTextBox"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         MaxLength="3"
                                         Text="{Binding CellNumberText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#C7372F"
                                           Text="{Binding ElementName=CellNumberTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="18"
                            Background="#FFFFFF"
                            CornerRadius="12"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Термін та додаткові відомості" />

                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Термін покарання (років) *" />
                                <DockPanel>
                                    <TextBox x:Name="SentenceYearsTextBox"
                                             Style="{StaticResource ValidationTextBoxStyle}"
                                             Width="150"
                                             MaxLength="2"
                                             IsEnabled="{Binding IsSentenceYearsEnabled}"
                                             Text="{Binding SentenceYearsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <CheckBox Margin="14,8,0,0"
                                              VerticalAlignment="Top"
                                              IsChecked="{Binding IsLifeSentence}"
                                              Content="Довічно" />
                                </DockPanel>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#C7372F"
                                           Text="{Binding ElementName=SentenceYearsTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Дата взяття під варту *" />
                                <DatePicker x:Name="ArrestDatePicker"
                                            Style="{StaticResource ValidationDatePickerStyle}"
                                            SelectedDate="{Binding ArrestDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#C7372F"
                                           Text="{Binding ElementName=ArrestDatePicker, Path=(Validation.Errors)[0].ErrorContent}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Дата звільнення" />
                                <Border Padding="12"
                                        Background="#EFF6FF"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#1D4ED8"
                                               Text="{Binding ReleaseDateText}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Місце в ієрархії" />
                                <ComboBox Style="{StaticResource ValidationComboBoxStyle}"
                                          ItemsSource="{Binding HierarchyOptions}"
                                          SelectedItem="{Binding SelectedHierarchyLevel}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Відомості про родичів" />
                                <TextBox x:Name="RelativesInfoTextBox"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         Height="96"
                                         MaxLength="500"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding RelativesInfo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#C7372F"
                                           Text="{Binding ElementName=RelativesInfoTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Особливості характеру" />
                                <TextBox x:Name="CharacterNotesTextBox"
                                         Style="{StaticResource ValidationTextBoxStyle}"
                                         Height="120"
                                         MaxLength="500"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding CharacterNotes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#C7372F"
                                           Text="{Binding ElementName=CharacterNotesTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
