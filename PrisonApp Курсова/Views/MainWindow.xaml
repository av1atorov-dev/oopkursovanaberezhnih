<Window x:Class="PrisonApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PrisonApp - Довідник начальника в'язниці"
        Width="1360"
        Height="820"
        MinWidth="1200"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Delete"
                    Command="{Binding DeleteCommand}" />
        <KeyBinding Modifiers="Control"
                    Key="N"
                    Command="{Binding AddCommand}" />
    </Window.InputBindings>

    <DockPanel Background="#F3F4F6">
        <Menu DockPanel.Dock="Top"
              Background="#FFFFFF">
            <MenuItem Header="_Файл">
                <MenuItem Header="Ви_хід"
                          Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Записи">
                <MenuItem Header="Додати"
                          Command="{Binding AddCommand}" />
                <MenuItem Header="Редагувати"
                          Command="{Binding EditCommand}" />
                <MenuItem Header="_Видалити"
                          Command="{Binding DeleteCommand}" />
                <MenuItem Header="Експорт у CSV"
                          Command="{Binding ExportCsvCommand}" />
                <MenuItem Header="Експорт у JSON"
                          Command="{Binding ExportJsonCommand}" />
                <MenuItem Header="Імпорт з JSON"
                          Command="{Binding ImportJsonCommand}" />
            </MenuItem>
            <MenuItem Header="_Статистика">
                <MenuItem Header="_Перегляд статистики"
                          Command="{Binding ShowStatisticsCommand}" />
            </MenuItem>
            <MenuItem Header="_Довідка">
                <MenuItem Header="_Про програму"
                          Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Background="#FFFFFF"
                BorderBrush="#D5D9E0"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <ToolBarTray Background="Transparent">
                    <ToolBar Background="#FFFFFF"
                             BorderThickness="0">
                        <Button Command="{Binding AddCommand}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Content="Додати" />
                        <Button Command="{Binding EditCommand}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Content="Редагувати" />
                        <Button Command="{Binding DeleteCommand}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Content="Видалити" />
                        
                        <Separator />
                        <Button Command="{Binding ShowStatisticsCommand}"
                                Padding="12,6"
                                Margin="8,0,0,0"
                                Content="Статистика" />
                    </ToolBar>
                </ToolBarTray>

                <Border Margin="0,12,0,0"
                        Padding="16"
                        CornerRadius="10"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="6"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Text="Пошук та фільтрація" />

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,14,12,0">
                            <TextBlock Margin="0,0,0,6"
                                       Foreground="#334155"
                                       Text="Пошук" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,7"
                                     MaxLength="100" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,14,12,0">
                            <TextBlock Margin="0,0,0,6"
                                       Foreground="#334155"
                                       Text="Камера" />
                            <ComboBox ItemsSource="{Binding CameraFilterOptions}"
                                      SelectedItem="{Binding SelectedCameraFilter}"
                                      DisplayMemberPath="DisplayText"
                                      Padding="8,6" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0,14,12,0">
                            <TextBlock Margin="0,0,0,6"
                                       Foreground="#334155"
                                       Text="Місце в ієрархії" />
                            <ComboBox ItemsSource="{Binding HierarchyFilterOptions}"
                                      SelectedItem="{Binding SelectedHierarchyFilter}"
                                      DisplayMemberPath="DisplayText"
                                      Padding="8,6" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="3"
                                    Margin="0,14,12,0">
                            <TextBlock Margin="0,0,0,6"
                                       Foreground="#334155"
                                       Text="Дата звільнення з" />
                            <DatePicker SelectedDate="{Binding ReleaseDateFrom, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="4"
                                    Margin="0,14,12,0">
                            <TextBlock Margin="0,0,0,6"
                                       Foreground="#334155"
                                       Text="Дата звільнення по" />
                            <DatePicker SelectedDate="{Binding ReleaseDateTo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button Grid.Row="1"
                                Grid.Column="5"
                                Margin="0,38,0,0"
                                Padding="14,8"
                                VerticalAlignment="Top"
                                Command="{Binding ResetFiltersCommand}"
                                Content="Скинути фільтри" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom"
                   Background="#FFFFFF"
                   BorderBrush="#D5D9E0"
                   BorderThickness="1,1,1,0">
            <StatusBarItem>
                <TextBlock Text="{Binding DisplayedCountText}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">
            <Border Background="#FFFFFF"
                    BorderBrush="#D7DCE4"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                <Grid>
                    <DataGrid x:Name="PrisonersDataGrid"
                              ItemsSource="{Binding FilteredPrisoners}"
                              SelectedItem="{Binding SelectedPrisoner}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              MouseDoubleClick="PrisonersDataGrid_MouseDoubleClick"
                              Sorting="PrisonersDataGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№"
                                                Binding="{Binding SequenceNumber}"
                                                Width="55"
                                                SortMemberPath="SequenceNumber" />
                            <DataGridTextColumn Header="Прізвище, ім'я, по батькові"
                                                Binding="{Binding FullName}"
                                                Width="2.1*" />
                            <DataGridTextColumn Header="Дата народження"
                                                Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}"
                                                Width="1.15*" />
                            <DataGridTextColumn Header="Стаття КК"
                                                Binding="{Binding CriminalArticle}"
                                                Width="1.1*" />
                            <DataGridTextColumn Header="Термін"
                                                Binding="{Binding SentenceDisplay}"
                                                Width="0.9*" />
                            <DataGridTextColumn Header="Дата взяття під варту"
                                                Binding="{Binding ArrestDate, StringFormat=dd.MM.yyyy}"
                                                Width="1.2*" />
                            <DataGridTextColumn Header="Дата звільнення"
                                                Binding="{Binding ReleaseDateDisplay}"
                                                Width="1.1*" />
                            <DataGridTextColumn Header="Камера"
                                                Binding="{Binding CellNumber}"
                                                Width="0.8*" />
                            <DataGridTextColumn Header="Ієрархія"
                                                Binding="{Binding HierarchyDisplay}"
                                                Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="#F8FAFC"
                            CornerRadius="10"
                            Padding="28"
                            Width="320"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Записів не знайдено" />
                            <TextBlock Margin="0,8,0,0"
                                       TextAlignment="Center"
                                       Foreground="#475569"
                                       Text="Змініть умови пошуку або скиньте фільтри, щоб побачити повний список." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </DockPanel>
</Window>
